      ]
    },
    {
      "line_range": "L184",
      "text": "In GeoDeploy, cluster and registry modules follow directly from the provider, such that AWS always means EKS and ECR.",
      "type": "behavior",
      "source_hint": "pulumi/devx-geodeploy",
      "confidence": "high",
