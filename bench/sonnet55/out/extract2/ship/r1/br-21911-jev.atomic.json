      "found_by": [
        "llm-atomic"
      ]
    },
    {
      "line_range": "L202-210",
      "text": "In GeoDeploy's engine.ts, the residencyOk check is a hard gate that hard-rejects the AI region selection and throws an AiPathAborted error when residencyOk falls below the 0.95 threshold, never soft-failing the compliance constraint.",
      "type": "behavior",
      "source_hint": "pulumi/devx-geodeploy",
      "confidence": "high",
      "file": "content/blog/self-driving-infrastructure-pulumi-jev/index.md",
      "found_by": [
        "llm-atomic"
      ]
    },
    {
      "line_range": "L212-217",
      "text": "GeoDeploy's engine.ts throws an AiPathAborted error if the model's selected candidate ID is not found among the shortlisted candidates.",
      "type": "behavior",
      "source_hint": "pulumi/devx-geodeploy",
      "confidence": "high",
