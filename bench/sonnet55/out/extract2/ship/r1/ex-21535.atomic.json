      "found_by": [
        "llm-atomic"
      ]
    },
    {
      "line_range": "L241-242",
      "text": "The `fixedResponse` listener default action returns a custom HTTP response rather than forwarding traffic.",
      "type": "api-surface",
      "source_hint": "pulumi awsx",
      "confidence": "high",
      "file": "content/docs/iac/guides/clouds/aws/elb.md",
      "found_by": [
        "llm-atomic"
      ]
    },
    {
      "line_range": "L244-245",
      "text": "The `redirect` listener default action redirects from one URL to another.",
