    },
    {
      "line_range": "L238-239",
      "text": "The `authenticateOidc` listener default action authenticates access through your load balancer using an OpenID Connect (OIDC) compliant identity provider.",
      "type": "api-surface",
      "source_hint": "pulumi awsx",
      "confidence": "high",
