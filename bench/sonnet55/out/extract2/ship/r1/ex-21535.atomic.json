      "file": "content/docs/iac/guides/clouds/aws/elb.md",
      "found_by": [
        "llm-atomic"
      ]
    },
    {
      "line_range": "L272-274",
      "text": "The `slowStart` target group property specifies the amount of time for ELB to wait before sending a target its full share of requests.",
