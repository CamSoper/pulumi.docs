      "found_by": [
        "llm-atomic"
      ]
    },
    {
      "line_range": "L268-270",
      "text": "The `deregistrationDelay` target group property's range is 0\u20133600 seconds.",
      "type": "numerical",
      "source_hint": "pulumi-aws / AWS Elastic Load Balancing",
      "confidence": "high",
      "file": "content/docs/iac/guides/clouds/aws/elb.md",
      "found_by": [
        "llm-atomic"
      ]
    },
    {
      "line_range": "L268-270",
      "text": "The default value of the `deregistrationDelay` target group property is 300.",
