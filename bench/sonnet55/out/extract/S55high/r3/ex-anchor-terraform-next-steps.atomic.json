        "llm-atomic"
      ]
    },
    {
      "line_range": "L152-160",
      "text": "`@pulumi/policy` exports `PolicyPack` and `validateResourceOfType`; policies take `name`, `description`, `enforcementLevel` (\"mandatory\") and `validateResource` properties.",
